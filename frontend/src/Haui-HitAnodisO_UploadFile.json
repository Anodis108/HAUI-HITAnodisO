          "script": "// Lấy chuỗi Base64 từ file1.value\nconst base64StringArray = file1.value;\nif (!Array.isArray(base64StringArray) || base64StringArray.length === 0) {\n  console.error(\"Dữ liệu Base64 không hợp lệ:\", base64StringArray);\n  return;\n}\n\n// Lấy chuỗi Base64 từ mảng\nconst base64String = base64StringArray[0];\n\n// Loại bỏ khoảng trắng trong Base64 (nếu có)\nconst sanitizedBase64String = base64String.replace(/\\s/g, \"\");\n\n// Thông tin tệp\nconst mimeType = \"application/pdf\"; // MIME type\nconst fileName = \"uploaded-file.pdf\"; // Tên file\n\ntry {\n  // Chuyển Base64 thành dữ liệu nhị phân (binary)\n  const binaryData = atob(sanitizedBase64String); // Giải mã Base64\n  const byteNumbers = new Uint8Array(binaryData.length); // Tạo Uint8Array\n  for (let i = 0; i < binaryData.length; i++) {\n    byteNumbers[i] = binaryData.charCodeAt(i); // Chuyển ký tự thành byte\n  }\n\n  // Tạo Blob từ binary data\n  const blob = new Blob([byteNumbers], { type: mimeType });\n\n  // Tạo FormData để gửi qua API\n  const formData = new FormData();\n  formData.append(\"file\", blob, fileName); // Thêm tệp vào FormData\n  formData.append(\"name\", \"Hoso\"); // Thêm thông tin bổ sung\n  formData.append(\"profileId\", localStorage.values.profileId); // Profile ID từ localStorage\n\n  fetch(\"http://103.140.39.136:443/api/v1/pdf\", {\n    method: \"POST\",\n    body: formData,\n    headers: {\n      Authorization: `Bearer ${localStorage.values['access-token']}`,\n    },\n  })\n    .then((response) => {\n      if (!response.ok) {\n        throw new Error(`HTTP error! status: ${response.status}`);\n      }\n      return response.json();\n    })\n    .then((result) => {\n      console.log(\"Upload thành công:\", result);\n    })\n    .catch((error) => {\n      console.error(\"Lỗi khi upload:\", error);\n    });\n} catch (error) {\n  console.error(\"Lỗi khi xử lý Base64:\", error);\n}\n"
        },
